RewriteEngine On
RewriteBase /

# Canonicaliza www -> sem-www (sem-www e o host canonico, pra onde os anuncios
# apontam). Preserva path e querystring/UTM via QSA. Roda ANTES do fallback SPA.
RewriteCond %{HTTP_HOST} ^www\.lpb\.planteumaflor\.com$ [NC]
RewriteRule ^(.*)$ https://lpb.planteumaflor.com/$1 [R=301,L,QSA]

RewriteRule ^index\.html$ - [L]

RewriteRule ^sem-erro/?$ /so-porque-sim [R=301,L]

# HTML estático por LP: /lirios-apt -> /lirios-apt.html. Esses arquivos trazem o
# preload do hero daquela LP e o CSS certo já no documento inicial (ver o plugin
# ad-landing-static-html). Vem antes do fallback do SPA e só age quando o
# arquivo existe; !-d preserva as páginas com diretório próprio (dia-das-maes/).
# O `/?` cobre /lirios-apt/ — a barra final precisa do DOCUMENT_ROOT porque
# REQUEST_FILENAME já viria com ela e nunca casaria com o .html.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+)/?$ /$1.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# Explicit modern image MIME types for Apache installations without them.
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
</IfModule>

# Vite emits content hashes in bundled asset names. Those files are immutable;
# HTML must always revalidate so it can point at the latest hashes.
<IfModule mod_headers.c>
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(?:avif|webp|jpe?g|png|svg|css|m?js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
