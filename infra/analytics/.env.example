# Copie para infra/analytics/.env.local (ignorado pelo git: .env.* e *.local) e preencha.
# Valores vazios são ERRO PROPOSITAL: o compose recusa subir sem eles. Sem defaults de produção.
# Uso:  docker compose --env-file infra/analytics/.env.local -f infra/analytics/compose.yaml config -q

# --- PostgreSQL local do compose (instância própria, host 127.0.0.1:55433) ---
# Use apenas caracteres URL-safe na senha (ex.: openssl rand -hex 24): ela entra na DATABASE_URL.
ANALYTICS_POSTGRES_USER=
ANALYTICS_POSTGRES_DB=
ANALYTICS_POSTGRES_PASSWORD=

# --- Contrato de ambiente do servidor ---
# RELEASE_SHA: git rev-parse HEAD do build (40 hex minúsculos); também é a tag da imagem.
# Com NODE_ENV=production o servidor RECUSA iniciar se não for 40 hex.
RELEASE_SHA=
# development | production | test (explícito; sem default).
# production exige: DATABASE_URL, ANALYTICS_SECURE_COOKIE=true, origins https://, RELEASE_SHA de 40 hex.
NODE_ENV=
# CSV de origins públicos autorizados em /collect (scheme+host+porta, sem path, sem "/" final).
# Produção: somente https://. Local: ex. http://localhost:8080 (não misturar com os de produção).
ANALYTICS_PUBLIC_ORIGINS=
# Um único origin do dashboard (CORS /admin/ com credenciais). Mesmas regras acima.
ANALYTICS_ADMIN_ORIGIN=
# O servidor só marca o cookie Secure quando o valor é exatamente "true".
# Produção: true. Local sobre HTTP: false, escrito de propósito.
ANALYTICS_SECURE_COOKIE=

# NÃO definir aqui (não são lidas do .env pelo compose e não devem ser persistidas):
#   ANALYTICS_ADMIN_PASSWORD  -> só inline no comando da CLI admin (ou senha por stdin).
# Sem segredo de runtime para sessão/CSRF: a chave HMAC do CSRF é gerada em memória a cada start.

# --- Opcional (compose) ---
# Porta no host (loopback). Container sempre escuta 8787. Default 8788 para não colidir
# com um `node server/analytics/main.ts` rodando direto no host em 8787.
# ANALYTICS_HOST_PORT=8788
# Porta do Postgres no host (loopback). Default 55433.
# ANALYTICS_PG_HOST_PORT=55433

# --- Backup/restore (scripts/) ---
# Diretório de backups (fora do repositório e fora do volume do banco). Default:
#   ${XDG_STATE_HOME:-$HOME/.local/state}/landing-analytics/backups
# ANALYTICS_BACKUP_DIR=
