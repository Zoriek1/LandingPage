# Copie para .env.local (ignorado pelo Git).
# Coleta própria desligada até conectar/verificar o adaptador da CMP.
VITE_ANALYTICS_ENABLED=false
# Vazio usa o proxy local do Vite para 127.0.0.1:8787.
# Em produção, definir somente após provisionar e validar a API HTTPS.
VITE_ANALYTICS_API_URL=

# Backend local: preencher antes de analytics:migrate / analytics:dev.
NODE_ENV=development
DATABASE_URL=
ANALYTICS_HOST=127.0.0.1
ANALYTICS_PORT=8787
ANALYTICS_PUBLIC_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ANALYTICS_ADMIN_ORIGIN=http://localhost:8080
ANALYTICS_SECURE_COOKIE=false
# Mesmo commit no backend/frontend; Vite obtém do Git quando omitido.
RELEASE_SHA=
